# Copiaza acest fisier in .env si completeaza valorile reale (nu se adauga in git)

# Conexiunea la baza de date PostgreSQL locala (rolul dedicat "ofertare", nu "postgres")
DATABASE_URL="postgresql://ofertare:PAROLA@localhost:5432/ofertare_dev?schema=public"
# Baza "shadow", folosita doar de Prisma Migrate pentru a calcula migrarile
SHADOW_DATABASE_URL="postgresql://ofertare:PAROLA@localhost:5432/ofertare_shadow?schema=public"

# Secretul pentru semnarea cookie-ului de sesiune (orice sir lung, aleator)
SESSION_SECRET="schimba-acest-sir-cu-unul-lung-si-aleator"

PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"

# Contul Admin general (creat de scriptul de seed) si contul lui de rezerva
# (fisa CONTURI §8.1) - parolele se tin DOAR aici, niciodata in cod sau in git
ADMIN_NUME="Ionut"
ADMIN_EMAIL="admin@exemplu.ro"
ADMIN_PAROLA="schimba-aceasta-parola"

ADMIN_REZERVA_NUME="Admin general - rezerva"
ADMIN_REZERVA_EMAIL="admin-rezerva@exemplu.ro"
ADMIN_REZERVA_PAROLA="schimba-si-aceasta-parola"
