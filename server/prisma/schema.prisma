generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // baza "shadow" folosita de Prisma Migrate pentru a calcula migrarile;
  // separata, ca rolul aplicatiei sa nu aiba nevoie de drept CREATEDB
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// tabelul de sesiuni al connect-pg-simple (schema ceruta de acel pachet);
// tinut in migrarea noastra, in loc sa fie creat ad-hoc la pornirea
// serverului, ca sa ramana in istoricul de migrari din git
model SesiuneExpres {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------------------------------------------------------------------------
// CON minim: firme, utilizatori, jurnal
// ---------------------------------------------------------------------------

enum RolUtilizator {
  ADMIN_GENERAL
  ADMINISTRATOR
  AGENT
  COLABORATOR
  CONTABILITATE
  GESTIUNE
}

enum RezultatAutentificare {
  SUCCES
  ESEC
  BLOCAT
}

model Firma {
  id          String   @id @default(uuid())
  denumire    String
  cui         String
  nrRegCom    String
  adresa      String
  telefon     String
  email       String
  contBancar  String?
  banca       String?
  platitorTva Boolean  @default(true)
  localitate  String?
  judet       String?
  observatii  String?
  logo        String?
  activ       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  utilizatori      Utilizator[]
  utilizatorFirmas UtilizatorFirma[]
  oferte           Oferta[]

  @@map("firma")
}

model Utilizator {
  id         String        @id @default(uuid())
  nume       String
  telefon    String?
  email      String        @unique
  parolaHash String
  rol        RolUtilizator

  // firma e obligatorie pentru ADMINISTRATOR; AGENT/COLABORATOR o mostenesc de
  // la administratorul lor; ADMIN_GENERAL, si CONTABILITATE/GESTIUNE cu acces
  // general, nu au o firma fixa (vezi UtilizatorFirma si accesGeneralFirme).
  firmaId String?
  firma   Firma?  @relation(fields: [firmaId], references: [id])

  // cine l-a creat / sub cine lucreaza (AGENT, COLABORATOR sub ADMINISTRATOR)
  administratorId String?
  administrator   Utilizator?  @relation("Subordonati", fields: [administratorId], references: [id])
  subordonati     Utilizator[] @relation("Subordonati")

  // 2-3 litere, unica, pentru numerotarea ofertelor (SERIE-NUMAR); doar la
  // conturile care fac oferte (ADMINISTRATOR, AGENT, COLABORATOR)
  serieOferta String? @unique

  // adaosul % al contului la pretul de achizitie (fisa CONTURI §7); orice cont
  // care face oferte are unul, modificabil cu istoric (JurnalIntrare)
  adaosProcent Decimal? @db.Decimal(6, 3)

  // relevant doar pentru CONTABILITATE / GESTIUNE: acces pe toate firmele
  // (altfel accesul e dat de randurile din UtilizatorFirma)
  accesGeneralFirme Boolean @default(false)

  // securitate (fisa CONTURI §8): parola pusa de altcineva se schimba la prima
  // conectare; blocare temporara dupa incercari gresite repetate
  parolaTrebuieSchimbata Boolean   @default(false)
  incercariEsuate        Int       @default(0)
  blocatPanaLa           DateTime?

  activ     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firmeAcces          UtilizatorFirma[]
  listePretCreate     ListaPret[]
  jurnalIntrari       JurnalIntrare[]
  oferte              Oferta[]            @relation("OferteCont")
  oferteCreate        Oferta[]            @relation("OferteCreate")
  oferteModificate    Oferta[]            @relation("OferteModificate")
  clientiCreati       Client[]
  ofertaIstoric       OfertaIstoric[]
  ofertaAtasamente    OfertaAtasament[]
  jurnalAutentificari JurnalAutentificare[]
  importPropuneres    ImportPropunere[]

  @@map("utilizator")
}

// acces pe mai multe firme pentru Contabilitate / Gestiune, cand nu e acces
// general si nu e o singura firma
model UtilizatorFirma {
  id           String     @id @default(uuid())
  utilizatorId String
  utilizator   Utilizator @relation(fields: [utilizatorId], references: [id])
  firmaId      String
  firma        Firma      @relation(fields: [firmaId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([utilizatorId, firmaId])
  @@map("utilizator_firma")
}

// jurnalul general de modificari (cine, cand, ce): fisa CONTURI §5 - orice
// suma modificata ulterior are istoric; numeUtilizatorLaMoment pastreaza
// numele persoanei chiar daca contul e redenumit ulterior (predare de cont)
model JurnalIntrare {
  id                     String      @id @default(uuid())
  utilizatorId           String?
  utilizator             Utilizator? @relation(fields: [utilizatorId], references: [id])
  numeUtilizatorLaMoment String
  moment                 DateTime    @default(now())
  entitate               String
  entitateId             String
  actiune                String
  camp                   String?
  valoareInainte         String?
  valoareDupa            String?

  @@index([entitate, entitateId])
  @@map("jurnal_intrare")
}

// jurnalul de autentificari: fisa CONTURI §8.3 - ultimele conectari (cand, de
// pe ce dispozitiv), separat de jurnalul general pentru ca are alta forma
model JurnalAutentificare {
  id            String                @id @default(uuid())
  utilizatorId  String?
  utilizator    Utilizator?           @relation(fields: [utilizatorId], references: [id])
  emailIncercat String
  moment        DateTime              @default(now())
  rezultat      RezultatAutentificare
  dispozitiv    String?
  sursa         String?

  @@map("jurnal_autentificare")
}

// ---------------------------------------------------------------------------
// CAT / LP: compartimente, grupuri, familii, produse, liste de pret
// ---------------------------------------------------------------------------

enum TipCompartiment {
  FURNIZOR
  STOC_PROPRIU
}

enum ModPret {
  LISTA_ACHIZITIE
  CATALOG_DISCOUNT
}

enum StatusListaPret {
  SCHITA
  ACTIVA
  ARHIVATA
  // schita neactivata, renuntata; nu se sterge
  ANULATA
}

enum StatusImport {
  PROPUSA
  CONFIRMATA
  ANULATA
}

model Compartiment {
  id           String          @id @default(uuid())
  denumire     String          @unique
  // identificator scurt si stabil (2-6 litere/cifre, ex. "BIL"), folosit ca
  // prefix la generarea codului intern al produselor - spre deosebire de
  // denumire, nu ar trebui schimbat dupa ce exista produse pe compartiment
  codScurt     String          @unique
  tip          TipCompartiment
  moneda       String
  modPret      ModPret
  // identificatorul adaptorului de import CSV (ex. "bilka-v1")
  formatImport String?

  contactFurnizorNume    String?
  contactFurnizorTelefon String?
  contactFurnizorEmail   String?
  contactDirectorZonal   String?

  activ     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grupuri          Grup[]
  produse          Produs[]
  listePret        ListaPret[]
  importPropuneres ImportPropunere[]

  @@map("compartiment")
}

// rubricile de oferta, comune peste compartimente (fisa CATALOG §1)
model CategorieOferta {
  id       String @id @default(uuid())
  denumire String @unique
  zona     String // "A" sau "B"
  ordine   Int    @default(0)

  produse Produs[]

  @@map("categorie_oferta")
}

model Grup {
  id             String       @id @default(uuid())
  compartimentId String
  compartiment   Compartiment @relation(fields: [compartimentId], references: [id])
  denumire       String
  ordine         Int          @default(0)

  familii Familie[]
  produse Produs[]

  @@unique([compartimentId, denumire])
  @@map("grup")
}

model Familie {
  id       String @id @default(uuid())
  grupId   String
  grup     Grup   @relation(fields: [grupId], references: [id])
  denumire String
  ordine   Int    @default(0)

  produse Produs[]

  @@unique([grupId, denumire])
  @@map("familie")
}

// campurile acopera toate coloanele din CSV-urile Bilka (vezi
// docs/import/Bilka/README.md "Coloanele CSV"), ca importul din S4 sa nu
// piarda nimic; valorile raman text brut asa cum vin din sursa, fara
// transformare la nivel de schema
model Produs {
  id             String       @id @default(uuid())
  compartimentId String
  compartiment   Compartiment @relation(fields: [compartimentId], references: [id])
  grupId         String
  grup           Grup         @relation(fields: [grupId], references: [id])
  familieId      String?
  familie        Familie?     @relation(fields: [familieId], references: [id])

  // cod intern, al nostru, stabil - singurul cod unic in catalog
  codIntern   String  @unique
  // codul furnizorului NU e unic ("un cod, doua produse")
  codFurnizor String?

  varianta String?
  finisaj  String?
  grosime  String?
  optiune  String?
  denumire String
  um       String

  // moneda produsului (implicit cea a compartimentului, fisa CATALOG regula 8)
  moneda String

  categorieOfertaId String?
  categorieOferta   CategorieOferta? @relation(fields: [categorieOfertaId], references: [id])
  // doar lista 01, eticheta Bilka cross-lista
  categorieBilka    String?

  latimeTotalaM     Decimal? @db.Decimal(8, 4)
  latimeTotalaMm    Decimal? @db.Decimal(8, 2)
  // modulul (35 la tigla)
  modulCm           Decimal? @db.Decimal(6, 2)
  // sistemul pluvial (ex. "125 / 90")
  sistem            String?
  // treapta D01-D25 (accesorii speciale)
  treapta           String?
  // intervalul desfasuratei (ex. "0-50 mm")
  desfasurata       String?
  // exceptii de culoare per produs (text brut CSV)
  culoriDisponibile String?

  sursa      String?
  observatii String?
  activ      Boolean @default(true)
  ordine     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preturi PretListaProdus[]
  ofertaInvelitori OfertaInvelitoare[]
  ofertaLinii      OfertaLinie[]

  @@index([compartimentId])
  @@index([codFurnizor])
  @@map("produs")
}

// o versiune a listei de pret a unui compartiment (fisa CATALOG regula 6: o
// singura versiune ACTIVA per compartiment la un moment dat - impusa printr-un
// index unic partial adaugat manual in migrare, vezi migration.sql)
model ListaPret {
  id             String          @id @default(uuid())
  compartimentId String
  compartiment   Compartiment    @relation(fields: [compartimentId], references: [id])
  denumire       String
  valabilaDeLa   DateTime
  sursa          String?
  status         StatusListaPret @default(SCHITA)
  creataDeId     String?
  creataDe       Utilizator?     @relation(fields: [creataDeId], references: [id])
  createdAt      DateTime        @default(now())

  // istoric liniar: schita -> activa -> arhivata (sau schita -> anulata);
  // o lista arhivata nu redevine niciodata activa (revenirea = reimport ca
  // versiune noua). Imutabilitatea arhivatelor e impusa de un trigger in baza.
  activataLa DateTime?
  arhivataLa DateTime?
  anulataLa  DateTime?

  // fisierele sursa, pastrate pe disc la versiune (nume, cale, numaratori)
  fisiere Json?
  // raportul de import (pe fisier + totaluri + avertizari)
  raport  Json?

  preturi   PretListaProdus[]
  propuneri ImportPropunere[]
  oferte    Oferta[]

  @@map("lista_pret")
}

// Pretul de listă al unui produs intr-o versiune (ARH §4.1 "Pret de listă")
model PretListaProdus {
  id          String    @id @default(uuid())
  listaPretId String
  listaPret   ListaPret @relation(fields: [listaPretId], references: [id])
  produsId    String
  produs      Produs    @relation(fields: [produsId], references: [id])
  pret        Decimal   @db.Decimal(12, 4)
  observatie  String?

  @@unique([listaPretId, produsId])
  @@map("pret_lista_produs")
}

// analiza unui import, intre "am incarcat fisierele" si "confirm": nimic nu
// se scrie in catalog pana la confirmare; ramane ca istoric al importurilor
model ImportPropunere {
  id             String       @id @default(uuid())
  compartimentId String
  compartiment   Compartiment @relation(fields: [compartimentId], references: [id])
  creatDeId      String?
  creatDe        Utilizator?  @relation(fields: [creatDeId], references: [id])
  status         StatusImport @default(PROPUSA)

  areProduse   Boolean @default(false)
  areReferinte Boolean @default(false)

  // fisierele incarcate: nume, cale pe disc, tip recunoscut, randuri
  fisiere    Json
  // diferentele calculate fata de catalog si lista activa
  diferente  Json
  // raportul pe fisier + totaluri
  raport     Json
  erori      Json
  avertizari Json
  // randurile de produse normalizate (sursa confirmarii, fara reincarcare)
  randuri    Json

  listaPretId  String?
  listaPret    ListaPret? @relation(fields: [listaPretId], references: [id])
  confirmataLa DateTime?
  anulataLa    DateTime?
  createdAt    DateTime   @default(now())

  @@index([compartimentId, createdAt])
  @@map("import_propunere")
}

// ---------------------------------------------------------------------------
// CAT: tabele de referinta (cele cinci CSV-uri auxiliare, plus categoriile
// de oferta) - scheletul lor acum, fara import (S4); coloanele copiaza exact
// coloanele CSV. "activ" e pe fiecare, ca o intrare gresita sa poata iesi
// din cascada fara sa dispara din istoric (nimic nu se sterge).
// ---------------------------------------------------------------------------

// variante-profil.csv: furnizor;model;varianta_profil;restrictii;lista_sursa
model VariantaProfil {
  id             String   @id @default(uuid())
  furnizor       String
  model          String
  variantaProfil String
  restrictii     String?
  listaSursa     String?
  activ          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("varianta_profil")
}

// culori-finisaj-grosime.csv: furnizor;finisaj;grosime;culoare
model CuloareFinisajGrosime {
  id        String   @id @default(uuid())
  furnizor  String
  finisaj   String
  grosime   String
  culoare   String
  activ     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([furnizor, finisaj, grosime, culoare])
  @@index([furnizor, finisaj, grosime])
  @@map("culoare_finisaj_grosime")
}

// garantii-finisaj-grosime.csv: furnizor;finisaj;grosime;garantie_culoare_ani;
// garantie_coroziune_ani;strat_zinc_g_mp;strat_vopsea_um_ext_int
model GarantieFinisajGrosime {
  id                   String   @id @default(uuid())
  furnizor             String
  finisaj              String
  grosime              String?
  garantieCuloareAni   Int?
  garantieCoroziuneAni Int
  stratZincGMp         Decimal? @db.Decimal(8, 2)
  // text brut, ex. "25 / 7" (exterior / interior) - nu e un numar simplu
  stratVopseaUmExtInt  String?
  activ                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([furnizor, finisaj, grosime])
  @@map("garantie_finisaj_grosime")
}

// liste-implicite-oferta.csv: furnizor;rubrica;categorie_invelitoare;ordine;produs
model ListaImplicitaOferta {
  id                   String   @id @default(uuid())
  furnizor             String
  rubrica              String
  categorieInvelitoare String
  ordine               Int
  produs               String
  activ                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([furnizor, categorieInvelitoare])
  @@map("lista_implicita_oferta")
}

// trepte-desfasurata.csv: furnizor;treapta;de_la_mm;pana_la_mm;denumire_bilka
model TreaptaDesfasurata {
  id            String   @id @default(uuid())
  furnizor      String
  treapta       String
  deLaMm        Int
  panaLaMm      Int
  denumireBilka String
  activ         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([furnizor, treapta])
  @@map("treapta_desfasurata")
}

// ---------------------------------------------------------------------------
// Ofertare (OFE) - migrarea 6 (S12). Structura urmeaza intrarea motorului de
// calcul (src/modules/mot/tipuri.ts): o oferta salvata se transforma 1:1 in
// IntrareOferta, fara traduceri. Sursa: FISA-OFERTARE v1.1 cap. 1, 2, 2b, 9,
// 11, 14, 15; FISA-CONTURI §2-3.
// ---------------------------------------------------------------------------

// cele 8 statusuri ale ofertei (FISA-OFERTARE cap. 14)
enum StatusOferta {
  IN_LUCRU
  TRANSMISA
  DE_REVIZIONAT
  ACCEPTATA
  NEACCEPTATA
  AVANS_LUAT
  DE_COMANDAT
  COMANDAT
}

enum ModPrezentare {
  SIMPLU
  LISTA_DISCOUNT_GENERAL
  DISCOUNT_PER_LINIE
}

// tinta: suma cu TVA in lei, adaos %, adaosul pastrat al variantei de baza,
// sau preluata din alta oferta (fara camp de tinta)
enum TipTinta {
  TOTAL_CU_TVA_LEI
  ADAOS_PCT
  ADAOS_PCT_PASTRAT
  PRELUATA
}

enum TipPretFix {
  EUR_FARA_TVA
  ACHIZITIE_PLUS_PCT
}

enum VariantaSipca {
  COMANDA
  CALCUL
}

// baza de clienti e comuna tuturor conturilor (cap. 2); telefonul normalizat
// (doar cifre, +40 / 0040 -> 0) e cheia de deduplicare
model Client {
  id                String      @id @default(uuid())
  nume              String
  telefon           String
  telefonNormalizat String      @unique
  adresa            String
  localitate        String?
  email             String?
  observatii        String?
  creatDeId         String?
  creatDe           Utilizator? @relation(fields: [creatDeId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  oferte Oferta[]

  @@map("client")
}

// cursul BNR al zilei (4 zecimale), preluat zilnic (11.8)
model CursValutar {
  id        String   @id @default(uuid())
  data      DateTime @db.Date
  moneda    String   @default("EUR")
  curs      Decimal  @db.Decimal(10, 4)
  sursa     String
  preluatLa DateTime @default(now())

  @@unique([data, moneda])
  @@map("curs_valutar")
}

// numerotarea continua pe serie (cap. 1): contorul se incrementeaza in
// tranzactie, la prima salvare; poate porni de la un numar dat (dupa prototip)
model ContorSerie {
  serie        String   @id
  ultimulNumar Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("contor_serie")
}

model Oferta {
  id String @id @default(uuid())

  firmaId      String
  firma        Firma      @relation(fields: [firmaId], references: [id])
  utilizatorId String
  utilizator   Utilizator @relation("OferteCont", fields: [utilizatorId], references: [id])

  // SERIE-NUMAR, continuu pe serie; variantele sunt versiuni sub acelasi numar
  serie    String
  numar    Int
  versiune Int     @default(1)
  curenta  Boolean @default(true)

  data       DateTime     @db.Date
  status     StatusOferta @default(IN_LUCRU)
  statusLa   DateTime     @default(now())
  // data statusului "Comandat" (blocul de la sfarsitul listei, cap. 15)
  comandatLa DateTime?

  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  sursaClient String?
  // adresa lucrarii si localitatea pe oferta (migrarea 7, S13): copiate din client
  // la creare, editabile - o completare preia adresa din oferta initiala (cap. 2b),
  // iar un client cu doua lucrari are doua adrese; fisa clientului pastreaza contactul
  adresaLucrarii String?
  localitate     String?
  // campul liber de precizari al zonei B (cap. 9)
  precizariZonaB String?

  // cele doua cursuri inghetate la creare (11.8): documentul = BNR al zilei,
  // achizitia = BNR x 1,01; data si sursa cursului; avertizare cand nu s-a
  // putut prelua cursul zilei (curs de ieri / offline)
  cursBnr        Decimal  @db.Decimal(10, 4)
  cursAchizitie  Decimal  @db.Decimal(10, 4)
  dataCurs       DateTime @db.Date
  sursaCurs      String
  avertizareCurs String?

  // versiunea listei de pret pe care s-a calculat (⚠ preturi vechi, 11.8)
  listaPretId String?
  listaPret   ListaPret? @relation(fields: [listaPretId], references: [id])
  tvaPct      Decimal    @db.Decimal(5, 2)

  modPrezentare       ModPrezentare @default(SIMPLU)
  discountGeneralPct  Decimal?      @db.Decimal(6, 3)
  discountImplicitPct Decimal?      @db.Decimal(6, 3)
  tintaTip            TipTinta      @default(ADAOS_PCT)
  tintaValoare        Decimal       @db.Decimal(14, 4)
  grupaPct            Decimal       @default(0) @db.Decimal(6, 3)

  // completare la oferta initiala (cap. 2b) si preluarea preturilor (11.11)
  completareLaId  String?
  completareLa    Oferta?  @relation("Completari", fields: [completareLaId], references: [id])
  completari      Oferta[] @relation("Completari")
  motivCompletare String?
  preluataDinId   String?
  preluataDin     Oferta?  @relation("Preluari", fields: [preluataDinId], references: [id])
  preluari        Oferta[] @relation("Preluari")

  note String?

  creatDeId     String?
  creatDe       Utilizator? @relation("OferteCreate", fields: [creatDeId], references: [id])
  modificatDeId String?
  modificatDe   Utilizator? @relation("OferteModificate", fields: [modificatDeId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  invelitori OfertaInvelitoare[]
  linii      OfertaLinie[]
  sipci      OfertaSipca[]
  zonaB      OfertaZonaB[]
  istoric    OfertaIstoric[]
  atasamente OfertaAtasament[]

  @@unique([serie, numar, versiune])
  @@index([firmaId, data])
  @@index([utilizatorId, data])
  @@index([clientId])
  @@index([status])
  @@map("oferta")
}

// invelitoarea cu snapshot-ul produsului si panotajul ei (cap. 3)
model OfertaInvelitoare {
  id       String @id @default(uuid())
  ofertaId String
  oferta   Oferta @relation(fields: [ofertaId], references: [id])
  ordine   Int
  // principala / secundara
  rol      String

  produsId    String?
  produs      Produs? @relation(fields: [produsId], references: [id])
  cod         String
  denumire    String
  um          String
  finisaj     String?
  grosime     String?
  grup        String?
  familie     String?
  optiune     String?
  // pretul de baza la momentul salvarii (snapshot); nu pleaca spre Agent / Colaborator
  pretBazaEur Decimal @db.Decimal(12, 4)

  culoare        String?
  latimeTotalaM  Decimal  @db.Decimal(8, 4)
  mpDirect       Decimal? @db.Decimal(12, 3)
  variantaProfil String?

  panotaj OfertaPozitie[]
  linii   OfertaLinie[]

  @@index([ofertaId])
  @@map("oferta_invelitoare")
}

// lungime x bucati: panotajul unei invelitori sau pozitiile unei linii la ml
model OfertaPozitie {
  id            String             @id @default(uuid())
  invelitoareId String?
  invelitoare   OfertaInvelitoare? @relation(fields: [invelitoareId], references: [id])
  linieId       String?
  linie         OfertaLinie?       @relation(fields: [linieId], references: [id])
  ordine        Int
  lungimeM      Decimal            @db.Decimal(8, 3)
  bucati        Int

  @@index([invelitoareId])
  @@index([linieId])
  @@map("oferta_pozitie")
}

// linia de oferta cu snapshot complet al produsului (ramane identica oricate
// liste de pret apar dupa ea)
model OfertaLinie {
  id       String @id @default(uuid())
  ofertaId String
  oferta   Oferta @relation(fields: [ofertaId], references: [id])
  ordine   Int
  rubrica  String

  produsId    String?
  produs      Produs? @relation(fields: [produsId], references: [id])
  cod         String
  denumire    String
  um          String
  finisaj     String?
  grosime     String?
  grup        String?
  familie     String?
  optiune     String?
  // sistemul pluvial din catalog (M2, migrarea 10): locurile de pe formularul Bilka
  sistem      String?
  pretBazaEur Decimal @db.Decimal(12, 4)

  cantitate Decimal @db.Decimal(12, 3)

  // legata de o invelitoare (mosteneste cheia ei) sau independenta, cu cheia ei
  invelitoareId  String?
  invelitoare    OfertaInvelitoare? @relation(fields: [invelitoareId], references: [id])
  culoareRal     String?
  culoareFinisaj String?
  culoareGrosime String?

  pretFixTip     TipPretFix?
  pretFixValoare Decimal?    @db.Decimal(12, 4)
  pretFixPreluat Boolean     @default(false)
  discountPct    Decimal?    @db.Decimal(6, 3)

  pozitii OfertaPozitie[]
  sipca   OfertaSipca?

  @@index([ofertaId])
  @@map("oferta_linie")
}

// rubricile de sipca de gard (cap. 8; M1, migrarea 8: oricate pe oferta, in
// ordine): modelul, latimea sipcii, varianta si tronsoanele; o linie = o rubrica
model OfertaSipca {
  id            String        @id @default(uuid())
  ofertaId      String
  oferta        Oferta        @relation(fields: [ofertaId], references: [id])
  ordine        Int           @default(1)
  linieId       String        @unique
  linie         OfertaLinie   @relation(fields: [linieId], references: [id])
  model         String
  culoare       String?
  latimeSipcaMm Decimal       @db.Decimal(8, 2)
  varianta      VariantaSipca

  tronsoane OfertaTronson[]

  @@index([ofertaId])
  @@map("oferta_sipca")
}

model OfertaTronson {
  id              String      @id @default(uuid())
  sipcaId         String
  sipca           OfertaSipca @relation(fields: [sipcaId], references: [id])
  ordine          Int
  lungimeSipcaM   Decimal     @db.Decimal(8, 3)
  lungimeTronsonM Decimal     @db.Decimal(8, 3)
  distantaMm      Decimal     @db.Decimal(8, 2)

  @@index([sipcaId])
  @@map("oferta_tronson")
}

// zona B (cap. 9): linii integral manuale, in lei
model OfertaZonaB {
  id             String  @id @default(uuid())
  ofertaId       String
  oferta         Oferta  @relation(fields: [ofertaId], references: [id])
  ordine         Int
  denumire       String
  um             String
  cantitate      Decimal @db.Decimal(12, 3)
  sumaLei        Decimal @db.Decimal(12, 2)
  contineTva     Boolean @default(false)
  preiaInFactura Boolean @default(false)

  @@index([ofertaId])
  @@map("oferta_zona_b")
}

// istoricul ofertei, de la "Transmisa" (cap. 14): cine, cand, ce, mentiuni
model OfertaIstoric {
  id                     String      @id @default(uuid())
  ofertaId               String
  oferta                 Oferta      @relation(fields: [ofertaId], references: [id])
  moment                 DateTime    @default(now())
  utilizatorId           String?
  utilizator             Utilizator? @relation(fields: [utilizatorId], references: [id])
  numeUtilizatorLaMoment String
  tip                    String
  camp                   String?
  valoareInainte         String?
  valoareDupa            String?
  mentiuni               String?

  @@index([ofertaId, moment])
  @@map("oferta_istoric")
}

// notite si atasamente pe oferta (poze, schite, documente), nu pe client
model OfertaAtasament {
  id           String      @id @default(uuid())
  ofertaId     String
  oferta       Oferta      @relation(fields: [ofertaId], references: [id])
  nume         String
  fisier       String
  tipMime      String?
  marime       Int?
  incarcatDeId String?
  incarcatDe   Utilizator? @relation(fields: [incarcatDeId], references: [id])
  moment       DateTime    @default(now())

  @@index([ofertaId])
  @@map("oferta_atasament")
}

// liste de optiuni configurabile (S14, migrarea 9): motivele completarii (cap. 2b),
// sursa clientului (cap. 2). Valorile initiale vin din
// docs/import/configurare/optiuni-liste.csv prin `npm run seed` (idempotent), nu
// din migrare; Admin general le intretine din Zona tehnica -> Referinte
model OptiuneLista {
  id      String  @id @default(uuid())
  lista   String
  valoare String
  ordine  Int     @default(0)
  activ   Boolean @default(true)

  @@unique([lista, valoare])
  @@index([lista, ordine])
  @@map("optiune_lista")
}
